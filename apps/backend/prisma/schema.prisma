// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime queries go through the pgbouncer transaction pooler (6543).
  url       = env("DATABASE_URL")
  // Migrations need a session connection (5432); pgbouncer cannot run them.
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName           String          @map("first_name")
  lastName            String          @map("last_name")
  email               String          @unique
  passwordHash        String          @map("password_hash")
  country             String?
  nationality         String?
  wewireSubcustomerId String?         @map("wewire_subcustomer_id")
  /// Wallet currency the user chose on first sign-on; null until they pick one.
  primaryCurrency     String?         @map("primary_currency")
  sourceOfFunds       String?         @map("source_of_funds")
  /// Mirrors of the WeWire sub-customer's compliance state, kept current by
  /// webhooks so the app need not call WeWire on every status read.
  onboardingStatus    String?         @map("onboarding_status")
  enhancedKycStatus   String?         @map("enhanced_kyc_status")
  kycStatusUpdatedAt  DateTime?       @map("kyc_status_updated_at") @db.Timestamptz
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  travelProfiles      TravelProfile[]
  wallets             Wallet[]
  fundingTransactions FundingTransaction[]
  beneficiaries       Beneficiary[]
  transactions        Transaction[]
  cryptoAddresses     CryptoDepositAddress[]
  walletSweeps        WalletSweep[]

  @@map("users")
}

model TravelProfile {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  destinationCountry  String   @map("destination_country")
  destinationCurrency String   @map("destination_currency")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("travel_profiles")
}

model Wallet {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  currency       String   @default("USD")
  balance        Decimal  @default(0.00) @db.Decimal(14, 2)
  wewireWalletId String?  @map("wewire_wallet_id")
  wewireAccountId String? @map("wewire_account_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

/// A crypto deposit address issued to a user, one per chain.
///
/// The address is WeWire's, not ours -- this row exists so an inbound deposit
/// webhook can be attributed to a user. A crypto deposit arrives unannounced,
/// with no pre-declared amount to match against, so the address is the only
/// thing tying it to an account.
model CryptoDepositAddress {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  subCustomerId  String   @map("sub_customer_id")
  /// WeWire's own address record id.
  wewireAddressId String  @map("wewire_address_id")
  chain          String
  /// MAINNET | TESTNET, as reported by the provider -- never inferred.
  network        String
  /// Null while issuance is still in flight.
  address        String?
  /// REQUESTED | ACTIVE | ...
  status         String   @default("REQUESTED")
  /// Assets this one address can receive, e.g. ["USDC","GHST"].
  supportedAssets String[] @map("supported_assets")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One address per user per chain, matching the provider's own idempotency.
  @@unique([userId, chain])
  @@index([address])
  @@map("crypto_deposit_addresses")
}

model FundingTransaction {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  /// What the user asked to send.
  amount     Decimal  @db.Decimal(14, 2)
  /// What actually landed after the rails took their cut. Null until settled.
  settledAmount Decimal? @map("settled_amount") @db.Decimal(14, 2)
  /// Fee deducted in transit, so the difference is explainable to the user.
  fee        Decimal  @default(0.00) @db.Decimal(14, 2)
  currency   String   @default("USD")
  checkoutId String?  @map("checkout_id")
  status     String   @default("PENDING")
  /// FIAT | CRYPTO. A fiat deposit is intent-first (the user declares an amount
  /// and this row exists before the money moves); a crypto deposit is
  /// address-first, so this row is created when the deposit is observed.
  source     String   @default("FIAT")
  /// Crypto only: the token received, e.g. 'USDC'.
  asset      String?
  /// Crypto only: the chain it arrived on, e.g. 'BASE'.
  chain      String?
  /// Crypto only: the on-chain transaction hash. Unique, because webhook
  /// redelivery is guaranteed and this is the only stable identity a crypto
  /// deposit carries.
  txHash     String?  @unique @map("tx_hash")
  /// Crypto only: the exact token amount received. Kept apart from `amount`
  /// because token decimals (USDC has 6) do not fit Decimal(14,2), and
  /// truncating a user's deposit is not an acceptable rounding.
  assetAmount Decimal? @map("asset_amount") @db.Decimal(38, 18)
  /// Crypto only: the rate the deposit was credited at, in wallet currency per
  /// token. Recorded so the gap between what we credited and what treasury
  /// eventually realises on conversion is measurable rather than invisible.
  conversionRate Decimal? @map("conversion_rate") @db.Decimal(24, 10)
  /// How that rate was arrived at: 'direct', 'inverse' or 'via:USD'.
  conversionVia  String?  @map("conversion_via")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("funding_transactions")
}

/// Audit trail of WeWire sweeping a sub-customer balance into the business
/// wallet. It moves no user money — the ledger is already credited by the
/// pay-in — but it is what reconciles that ledger against the business float.
model WalletSweep {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String?  @map("user_id") @db.Uuid
  subCustomerId        String   @map("sub_customer_id")
  amount               Decimal  @db.Decimal(14, 2)
  currency             String
  direction            String   @default("AUTO")
  fromWalletId         String?  @map("from_wallet_id")
  toWalletId           String?  @map("to_wallet_id")
  depositTransactionId String?  @unique @map("deposit_transaction_id")
  debitTransactionId   String?  @map("debit_transaction_id")
  creditTransactionId  String?  @map("credit_transaction_id")
  sweptAt              DateTime @map("swept_at") @db.Timestamptz
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  user                 User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([subCustomerId])
  @@map("wallet_sweeps")
}

model WebhookEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider  String   @default("wewire")
  eventType String   @map("event_type")
  eventId   String   @unique @map("event_id")
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("webhook_events")
}

model Beneficiary {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  name                String
  country             String
  network             String
  channel             String   @default("MOBILE_MONEY") // 'MOBILE_MONEY' | 'BANK'
  phone               String?
  accountNumber       String?  @map("account_number")
  institutionCode     String?  @map("institution_code") // WeWire sort code, e.g. MTN or GCB
  wewireBeneficiaryId String?  @map("wewire_beneficiary_id")
  wewireAccountId     String?  @map("wewire_account_id")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("beneficiaries")
}

model Transaction {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  type                String   // 'payout' | 'topup'
  status              String   // 'CREATED' | 'PENDING' | 'PROCESSING' | 'COMPLETED' | 'FAILED'
  sourceCurrency      String   @map("source_currency")
  sourceAmount        Decimal  @map("source_amount") @db.Decimal(14, 2)
  destinationCurrency String   @map("destination_currency")
  destinationAmount   Decimal  @map("destination_amount") @db.Decimal(14, 2)
  fee                 Decimal  @db.Decimal(14, 2)
  wewireFee           Decimal  @default(0.00) @map("wewire_fee") @db.Decimal(14, 2)
  exchangeRate        Decimal  @map("exchange_rate") @db.Decimal(14, 6)
  recipientName       String?  @map("recipient_name")
  recipientPhone      String?  @map("recipient_phone")
  recipientAccount    String?  @map("recipient_account") // bank account number for BANK payouts
  channel             String   @default("MOBILE_MONEY") // 'MOBILE_MONEY' | 'BANK'
  institutionCode     String?  @map("institution_code") // WeWire sort code used for the payout
  network             String?
  country             String?
  wewireTransactionId String?  @map("wewire_transaction_id")
  idempotencyKey      String   @unique @map("idempotency_key")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}


